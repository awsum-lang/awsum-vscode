{
  "name": "Awsum layer0",
  "scopeName": "source.awsum.layer0",
  "fileTypes": ["awsum"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#type_declaration" },
    { "include": "#signature" },
    { "include": "#function_definition" },
    { "include": "#expression" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "invalid.illegal.awsum",
          "match": "(?<=[^ ])#.*$|#(?! |$).*$"
        },
        {
          "name": "comment.awsum",
          "begin": "#",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.awsum" }
          },
          "end": "$"
        }
      ]
    },

    "type_declaration": {
      "name": "meta.type-declaration.awsum",
      "begin": "^(type)(?![A-Za-z0-9_'])",
      "beginCaptures": {
        "1": { "name": "keyword.awsum" }
      },
      "end": "^(?=\\S)",
      "patterns": [{ "include": "#type_body" }]
    },

    "signature": {
      "name": "meta.type-signature.awsum",
      "begin": "^([a-z][A-Za-z0-9_']*)(?:(:)| +(:))",
      "beginCaptures": {
        "1": { "name": "entity.name.function.awsum" },
        "2": { "name": "invalid.illegal.awsum" },
        "3": { "name": "punctuation.separator.type.annotation.awsum" }
      },
      "end": "^(?=\\S)",
      "patterns": [{ "include": "#type_body" }]
    },

    "type_body": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#separation" },
        { "include": "#string" },
        { "include": "#character" },
        { "include": "#keywords" },
        { "include": "#integer" },
        { "include": "#operators" },
        { "include": "#parens" },
        {
          "name": "entity.name.type.awsum",
          "match": "(?<![A-Za-z0-9_'])[A-Z][A-Za-z0-9_']*"
        },
        {
          "name": "variable.awsum",
          "match": "(?<![A-Za-z0-9_'])[a-z][A-Za-z0-9_']*"
        },
        { "include": "#bytes" }
      ]
    },

    "function_definition": {
      "name": "meta.function.definition.awsum",
      "begin": "^([a-z][A-Za-z0-9_']*)(?![A-Za-z0-9_'])",
      "beginCaptures": {
        "1": { "name": "entity.name.function.awsum" }
      },
      "end": "(?<=[^ (])(=)|(=)|^(?=\\S)",
      "endCaptures": {
        "1": { "name": "invalid.illegal.awsum" },
        "2": { "name": "keyword.operator.awsum" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#separation" },
        {
          "name": "invalid.illegal.awsum",
          "match": "(?<![A-Za-z0-9_'])_[A-Za-z0-9_']+"
        },
        {
          "name": "meta.type-signature.awsum",
          "begin": ":",
          "beginCaptures": {
            "0": { "name": "punctuation.separator.type.annotation.awsum" }
          },
          "end": "^(?=\\S)",
          "patterns": [{ "include": "#type_body" }]
        },
        {
          "name": "variable.language.awsum",
          "match": "(?<![A-Za-z0-9_'])_(?![A-Za-z0-9_'])"
        },
        {
          "name": "variable.parameter.function.awsum",
          "match": "(?<![A-Za-z0-9_'])[a-z][A-Za-z0-9_']*"
        },
        { "include": "#bytes" }
      ]
    },

    "expression": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#separation" },
        { "include": "#string" },
        { "include": "#character" },
        { "include": "#keywords" },
        { "include": "#builtins" },
        { "include": "#integer" },
        { "include": "#operators" },
        { "include": "#parens" },
        { "include": "#identifiers" },
        { "include": "#bytes" }
      ]
    },

    "separation": {
      "name": "invalid.illegal.awsum",
      "match": "(?<=[^ (A-Za-z_'])[A-Za-z][A-Za-z0-9_']*|(?<=[^ (])(?:-?[0-9]+|'(?:\\\\.|[^'\\\\])'|\"(?:\\\\.|[^\"\\\\])*\"?|->|[(=|:_])"
    },

    "string": {
      "patterns": [
        {
          "name": "invalid.illegal.awsum",
          "match": "\"(?:[^\"\\\\]|\\\\.)*\\\\?$"
        },
        {
          "name": "string.awsum",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.awsum" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.awsum" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.awsum",
              "match": "\\\\[ntr\"\\\\0]"
            },
            {
              "name": "invalid.illegal.awsum",
              "match": "\\\\."
            },
            { "name": "invalid.illegal.awsum", "match": "[\\x00-\\x1F]" }
          ]
        }
      ]
    },

    "character": {
      "patterns": [
        {
          "name": "constant.character.awsum",
          "match": "(?<![A-Za-z0-9_'])'(?:(\\\\[ntr\"\\\\0'])|[\\x20-\\x26\\x28-\\x5B\\x5D-\\x7E])'",
          "captures": {
            "1": { "name": "constant.character.escape.awsum" }
          }
        },
        {
          "name": "invalid.illegal.awsum",
          "match": "(?<![A-Za-z0-9_'])'(?:\\\\.|[^'\\\\])*'?"
        }
      ]
    },

    "keywords": {
      "name": "keyword.awsum",
      "match": "(?<![A-Za-z0-9_'])(?:case|of|let|in)(?![A-Za-z0-9_'])"
    },

    "builtins": {
      "name": "support.function.awsum",
      "match": "(?<![A-Za-z0-9_'])(?:add|sub|mul|div|rem|eq|lt|strLen|strByte|strSlice|strEq|strJoin|strFromByte|panic)(?![A-Za-z0-9_'])"
    },

    "integer": {
      "patterns": [
        {
          "name": "invalid.illegal.awsum",
          "match": "(?:-|(?<![A-Za-z0-9_']))(?:0[0-9]+|[1-9][0-9]{19,})|-0"
        },
        {
          "name": "constant.numeric.awsum",
          "match": "-[0-9]+|(?<![A-Za-z0-9_'])[0-9]+"
        }
      ]
    },

    "operators": {
      "patterns": [
        { "name": "keyword.operator.awsum", "match": "->|=|\\|" },
        {
          "name": "invalid.illegal.awsum",
          "match": "-(?![0-9>])|(?<![A-Za-z0-9_'])_[A-Za-z0-9_']+"
        },
        {
          "name": "variable.language.awsum",
          "match": "(?<![A-Za-z0-9_'])_(?![A-Za-z0-9_'])"
        }
      ]
    },

    "parens": {
      "patterns": [
        { "name": "punctuation.section.parens.begin.awsum", "match": "\\(" },
        { "name": "punctuation.section.parens.end.awsum", "match": "\\)" }
      ]
    },

    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.type.awsum",
          "match": "(?<![A-Za-z0-9_'])[A-Z][A-Za-z0-9_']*"
        },
        {
          "name": "variable.other.awsum",
          "match": "(?<![A-Za-z0-9_'])[a-z][A-Za-z0-9_']*"
        }
      ]
    },

    "bytes": {
      "name": "invalid.illegal.awsum",
      "match": "[^\\x20-\\x7E]|[!$%&*+,./;<>?@\\[\\\\\\]^`{}~]"
    }
  }
}
