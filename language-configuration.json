{
  "comments": {
    "lineComment": { "comment": "#" }
  },
  "brackets": [["(", ")"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "-?[0-9]+|[A-Za-z][A-Za-z0-9_']*"
}
